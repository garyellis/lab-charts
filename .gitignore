# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.tox/
.nox/
.hypothesis/

# Python packaging and coverage output
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# uv local cache, if configured in the repo
.uv-cache/

# Local generated trust bundles
.certs/

# Helm dependency artifacts
charts/*/charts/*.tgz
charts/*/charts/*.tar.gz
charts/*/charts/*/

# Agent/editor scratch. `.claude/` holds per-workstation settings, agent
# memory and worktrees; nothing under it is tracked. Ignoring it here rather
# than relying on a developer's global gitignore is what keeps a fresh CI
# clone running `git add -A` from committing someone's local permissions
# file. Force-add (`git add -f`) if a shared project setting ever lands.
**/.claude/

# Local/editor artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.bak
*.tmp
*.orig
*~
*.log

# Generated chart-manager output and local evidence. Repository-authored
# environment and stack resources remain versioned for fresh checkouts and CI.
.chart-manager/*
!.chart-manager/local-cluster.yaml
!.chart-manager/stacks/
!.chart-manager/stacks/*.yaml

*.env
