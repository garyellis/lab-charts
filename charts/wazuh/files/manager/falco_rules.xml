<!-- Falco alerts from charts/falco, read by charts/wazuh-agent from
     /var/log/falco/events.json and parsed by the built-in JSON decoder.
     Levels follow Falco's priority; the full alert stays under data.*. -->
<group name="falco,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="rule">\.+</field>
    <field name="priority">^Emergency$|^Alert$|^Critical$|^Error$|^Warning$|^Notice$|^Informational$|^Debug$</field>
    <field name="output">\.+</field>
    <description>Falco alert.</description>
  </rule>

  <rule id="100101" level="12">
    <if_sid>100100</if_sid>
    <field name="priority">^Emergency$|^Alert$|^Critical$</field>
    <description>Falco $(priority): $(rule) (ns=$(output_fields.k8s.ns.name) pod=$(output_fields.k8s.pod.name))</description>
  </rule>

  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="priority">^Error$</field>
    <description>Falco $(priority): $(rule) (ns=$(output_fields.k8s.ns.name) pod=$(output_fields.k8s.pod.name))</description>
  </rule>

  <rule id="100103" level="7">
    <if_sid>100100</if_sid>
    <field name="priority">^Warning$</field>
    <description>Falco $(priority): $(rule) (ns=$(output_fields.k8s.ns.name) pod=$(output_fields.k8s.pod.name))</description>
  </rule>

  <rule id="100104" level="5">
    <if_sid>100100</if_sid>
    <field name="priority">^Notice$</field>
    <description>Falco $(priority): $(rule) (ns=$(output_fields.k8s.ns.name) pod=$(output_fields.k8s.pod.name))</description>
  </rule>

  <rule id="100105" level="3">
    <if_sid>100100</if_sid>
    <field name="priority">^Informational$|^Debug$</field>
    <description>Falco $(priority): $(rule) (ns=$(output_fields.k8s.ns.name) pod=$(output_fields.k8s.pod.name))</description>
  </rule>

</group>
