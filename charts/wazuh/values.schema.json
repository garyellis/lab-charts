{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appsDomain",
    "certificates",
    "credentials",
    "dashboard",
    "images",
    "indexer",
    "istio",
    "manager",
    "reloader",
    "sso",
    "tests"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "appsDomain": {
      "$ref": "#/definitions/dnsName"
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "create",
        "values"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "create": {
          "type": "boolean",
          "description": "CI/kind only: render the Secret from credentials.values."
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indexerAdminPassword": {
              "$ref": "#/definitions/password"
            },
            "indexerDashboardPassword": {
              "$ref": "#/definitions/password"
            },
            "apiPassword": {
              "description": "Wazuh API policy: 8-64 chars with upper, lower, digit and symbol.",
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/definitions/password"
                    },
                    {
                      "pattern": "[A-Z]"
                    },
                    {
                      "pattern": "[a-z]"
                    },
                    {
                      "pattern": "[0-9]"
                    },
                    {
                      "pattern": "[.+@-]"
                    },
                    {
                      "maxLength": 64
                    }
                  ]
                }
              ]
            },
            "authdPassword": {
              "$ref": "#/definitions/password"
            },
            "clusterKey": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9]{32}$",
              "description": "Exactly 32 alphanumeric characters."
            },
            "indexerWriterPassword": {
              "$ref": "#/definitions/password"
            },
            "dashboardCookiePassword": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9.+@-]{31,127}$",
              "description": "At least 32 characters."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "create": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              },
              "values": {
                "properties": {
                  "indexerAdminPassword": {
                    "const": ""
                  },
                  "indexerDashboardPassword": {
                    "const": ""
                  },
                  "apiPassword": {
                    "const": ""
                  },
                  "authdPassword": {
                    "const": ""
                  },
                  "clusterKey": {
                    "const": ""
                  },
                  "indexerWriterPassword": {
                    "const": ""
                  },
                  "dashboardCookiePassword": {
                    "const": ""
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "create": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "existingSecret": {
                "const": "",
                "description": "credentials.create and credentials.existingSecret are mutually exclusive"
              },
              "values": {
                "required": [
                  "indexerAdminPassword",
                  "indexerDashboardPassword",
                  "apiPassword",
                  "authdPassword",
                  "clusterKey",
                  "indexerWriterPassword",
                  "dashboardCookiePassword"
                ],
                "properties": {
                  "indexerAdminPassword": {
                    "minLength": 1
                  },
                  "indexerDashboardPassword": {
                    "minLength": 1
                  },
                  "apiPassword": {
                    "minLength": 1
                  },
                  "authdPassword": {
                    "minLength": 1
                  },
                  "clusterKey": {
                    "minLength": 1
                  },
                  "indexerWriterPassword": {
                    "minLength": 1
                  },
                  "dashboardCookiePassword": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "certificates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerRef",
        "subject",
        "duration",
        "renewBefore",
        "caDuration"
      ],
      "properties": {
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 253
            },
            "kind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            }
          }
        },
        "duration": {
          "$ref": "#/definitions/duration"
        },
        "renewBefore": {
          "$ref": "#/definitions/duration"
        },
        "caDuration": {
          "$ref": "#/definitions/duration"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "organizationalUnit"
          ],
          "properties": {
            "organization": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 .-]{0,63}$"
            },
            "organizationalUnit": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9 .-]{0,63}$"
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pullPolicy",
        "indexer",
        "manager",
        "dashboard"
      ],
      "properties": {
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always"
          ]
        },
        "indexer": {
          "$ref": "#/definitions/image"
        },
        "manager": {
          "$ref": "#/definitions/image"
        },
        "dashboard": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "indexer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "clusterName",
        "javaOpts",
        "diskThresholdEnabled",
        "resources",
        "storage",
        "sysctlInitContainer",
        "pdb"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "not": {
            "const": 2
          },
          "description": "1 (single-node) or an odd-friendly quorum of 3+; 2 cannot survive losing a cluster manager."
        },
        "clusterName": {
          "type": "string",
          "pattern": "^[a-z0-9][-a-z0-9]{0,62}$"
        },
        "javaOpts": {
          "type": "string",
          "pattern": "^-Xms[0-9]+[mg] -Xmx[0-9]+[mg]( -[-A-Za-z0-9:=+._]+)*$"
        },
        "diskThresholdEnabled": {
          "type": "boolean"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "storage": {
          "$ref": "#/definitions/storage"
        },
        "sysctlInitContainer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "nodeSelector": {
          "$ref": "#/definitions/nodeSelector"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master",
        "workers",
        "agentServices",
        "archives",
        "vulnerabilityDetection",
        "localRules",
        "localDecoders"
      ],
      "properties": {
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resources",
            "storage"
          ],
          "properties": {
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "storage": {
              "$ref": "#/definitions/storage"
            },
            "nodeSelector": {
              "$ref": "#/definitions/nodeSelector"
            },
            "tolerations": {
              "$ref": "#/definitions/tolerations"
            },
            "affinity": {
              "type": "object"
            }
          }
        },
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replicas",
            "resources",
            "storage",
            "pdb"
          ],
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "storage": {
              "$ref": "#/definitions/storage"
            },
            "pdb": {
              "$ref": "#/definitions/pdb"
            },
            "nodeSelector": {
              "$ref": "#/definitions/nodeSelector"
            },
            "tolerations": {
              "$ref": "#/definitions/tolerations"
            },
            "affinity": {
              "type": "object"
            }
          }
        },
        "agentServices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "annotations",
            "loadBalancerSourceRanges"
          ],
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "loadBalancerSourceRanges": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "LoadBalancer"
              }
            }
          },
          "then": {
            "properties": {
              "loadBalancerSourceRanges": {
                "minItems": 1
              }
            }
          }
        },
        "archives": {
          "$ref": "#/definitions/toggle"
        },
        "vulnerabilityDetection": {
          "$ref": "#/definitions/toggle"
        },
        "localRules": {
          "type": "string",
          "maxLength": 262144
        },
        "localDecoders": {
          "type": "string",
          "maxLength": 262144
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/nodeSelector"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "gateway",
        "dashboard"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "existing",
            "name",
            "namespace",
            "selector",
            "tls"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "existing": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            },
            "namespace": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            },
            "selector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "credentialName"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "SIMPLE"
                  ]
                },
                "credentialName": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                }
              }
            }
          },
          "if": {
            "properties": {
              "create": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "tls": {
                "properties": {
                  "credentialName": {
                    "minLength": 1
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "existing": {
                "minLength": 1
              }
            }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostPrefix",
            "hosts",
            "backendTLS"
          ],
          "properties": {
            "hostPrefix": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            },
            "hosts": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/dnsName"
              }
            },
            "backendTLS": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "credentialName"
              ],
              "properties": {
                "credentialName": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                }
              }
            }
          }
        }
      }
    },
    "sso": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicUrl",
        "oidc",
        "saml",
        "roleMappings"
      ],
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^$|^https://[^\\s]+$"
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "connectUrl",
            "logoutUrl",
            "scope",
            "subjectKey",
            "rolesKey",
            "loginButtonText",
            "clientSecret"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "connectUrl": {
              "type": "string",
              "pattern": "^$|^https://[^\\s]+$"
            },
            "logoutUrl": {
              "type": "string",
              "pattern": "^$|^https://[^\\s]+$"
            },
            "scope": {
              "type": "string",
              "pattern": "^openid( [A-Za-z0-9_:.-]+)*$"
            },
            "subjectKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "rolesKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "loginButtonText": {
              "type": "string",
              "maxLength": 64
            },
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "clientIdKey",
                "clientSecretKey"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253
                },
                "clientIdKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecretKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "connectUrl": {
                "minLength": 1
              },
              "logoutUrl": {
                "minLength": 1
              },
              "clientSecret": {
                "properties": {
                  "name": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "saml": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "idpMetadataUrl",
            "idpEntityId",
            "spEntityId",
            "rolesKey",
            "exchangeKeySecret"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "idpMetadataUrl": {
              "type": "string",
              "pattern": "^$|^https://[^\\s]+$"
            },
            "idpEntityId": {
              "type": "string",
              "maxLength": 1024
            },
            "spEntityId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "rolesKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "exchangeKeySecret": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "idpMetadataUrl": {
                "minLength": 1
              },
              "idpEntityId": {
                "minLength": 1
              },
              "exchangeKeySecret": {
                "properties": {
                  "name": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "roleMappings": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingressGateway",
        "resources"
      ],
      "properties": {
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "ingressGateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "port"
          ],
          "properties": {
            "service": {
              "$ref": "#/definitions/dnsName"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "reloader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "dnsName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "password": {
      "description": "Upstream entrypoints interpolate secrets into sed, shell and YAML unescaped; keep to this character set.",
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9.+@-]{11,127}$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+h$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}(@sha256:[a-f0-9]{64})?$",
          "not": {
            "const": "latest"
          }
        }
      }
    },
    "quantity": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "storageClassName"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        },
        "storageClassName": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object"
      }
    }
  }
}
