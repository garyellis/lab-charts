{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "manager",
    "enrollment",
    "identity",
    "host",
    "fim",
    "logs",
    "resources",
    "updateStrategy",
    "tolerations",
    "tests"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(@sha256:[a-f0-9]{64})?$",
          "description": "Pinned Wazuh version; must not exceed the manager's."
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "registration"
      ],
      "properties": {
        "events": {
          "$ref": "#/definitions/endpoint"
        },
        "registration": {
          "$ref": "#/definitions/endpoint"
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "key",
        "groups"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[-._a-zA-Z0-9]+$"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,255}$"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostStatePath"
      ],
      "properties": {
        "hostStatePath": {
          "type": "string",
          "pattern": "^/var/lib/[A-Za-z0-9._-]+$",
          "description": "Dedicated node directory for client.keys."
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/(etc|var/log|usr/bin|usr/sbin|usr/local/bin|bin|sbin|boot|opt)(/[A-Za-z0-9._-]+)*$",
            "description": "Mounted read-only at /host<path>. Allow-listed roots; never / or runtime sockets."
          }
        }
      }
    },
    "fim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "directories",
        "ignore"
      ],
      "properties": {
        "frequency": {
          "type": "integer",
          "minimum": 300,
          "maximum": 604800
        },
        "directories": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "realtime"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/host/[A-Za-z0-9._/-]+$"
              },
              "realtime": {
                "type": "boolean"
              }
            }
          }
        },
        "ignore": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^/host/[A-Za-z0-9._/-]+$"
          }
        }
      }
    },
    "logs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "format"
        ],
        "properties": {
          "location": {
            "type": "string",
            "pattern": "^/host/[A-Za-z0-9._/*-]+$"
          },
          "format": {
            "enum": [
              "syslog",
              "json",
              "audit",
              "apache",
              "nmapg",
              "mysql_log",
              "postgresql_log",
              "multi-line",
              "full_command",
              "command",
              "djb-multilog",
              "snort-full",
              "squid"
            ]
          }
        }
      }
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUnavailable"
      ],
      "properties": {
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]?%$"
            }
          ]
        }
      }
    },
    "priorityClassName": {
      "type": "string",
      "maxLength": 253
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "resources"
      ],
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "username",
            "existingSecret",
            "key"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
            },
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "existingSecret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    }
  },
  "definitions": {
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9]([-A-Za-z0-9.]*[A-Za-z0-9])?$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "quantity": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "port"
      ],
      "properties": {
        "address": {
          "$ref": "#/definitions/host"
        },
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    }
  }
}
