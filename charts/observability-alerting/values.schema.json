{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string", "maxLength": 63},
    "fullnameOverride": {"type": "string", "maxLength": 63},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "hub", "ai1"],
      "properties": {
        "tenantId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "hub": {
          "type": "object", "additionalProperties": false,
          "required": ["cluster", "clusterRole", "lane", "stage", "region", "cloud", "tenant"],
          "properties": {
            "cluster": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "clusterRole": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "lane": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "stage": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "region": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "cloud": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "tenant": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
          }
        },
        "ai1": {
          "type": "object", "additionalProperties": false, "required": ["infra"],
          "properties": {"infra": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}}
        }
      }
    },
    "links": {
      "type": "object", "additionalProperties": false,
      "required": ["runbookBaseUrl", "dashboardBaseUrl"],
      "properties": {
        "runbookBaseUrl": {"type": "string", "pattern": "^https?://.+"},
        "dashboardBaseUrl": {"type": "string", "pattern": "^https?://.+"}
      }
    },
    "thanosRuler": {"$ref": "#/definitions/thanosRuler"},
    "alertmanager": {"$ref": "#/definitions/alertmanager"},
    "delivery": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "webhook"],
      "properties": {
        "enabled": {"type": "boolean"},
        "webhook": {
          "type": "object", "additionalProperties": false,
          "required": ["secretName", "secretKey", "maxAlerts"],
          "properties": {
            "secretName": {"type": "string", "maxLength": 253},
            "secretKey": {"type": "string", "maxLength": 253},
            "maxAlerts": {"type": "integer", "minimum": 0, "maximum": 1000}
          }
        }
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["groupBy", "groupWait", "groupInterval", "repeatInterval"],
      "properties": {
        "groupBy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["alertname", "severity", "service", "component", "scope", "alert_family"]}},
        "groupWait": {"$ref": "#/definitions/duration"},
        "groupInterval": {"$ref": "#/definitions/duration"},
        "repeatInterval": {"$ref": "#/definitions/duration"}
      }
    },
    "monitoring": {"$ref": "#/definitions/monitoring"},
    "telemetry": {"$ref": "#/definitions/telemetry"},
    "openstack": {
      "type": "object", "additionalProperties": false, "required": ["expectedFamilies"],
      "properties": {"expectedFamilies": {"type": "array", "uniqueItems": true, "items": {"enum": ["identity", "placement", "loadbalancer", "designate", "nova", "neutron"]}}}
    },
    "libvirt": {"$ref": "#/definitions/jobOnly"},
    "cinder": {
      "type": "object", "additionalProperties": false,
      "required": ["staleAfterSeconds", "dataWarningPercent", "dataCriticalPercent", "metadataWarningPercent", "metadataCriticalPercent"],
      "properties": {
        "staleAfterSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "dataWarningPercent": {"type": "number", "minimum": 1, "maximum": 99},
        "dataCriticalPercent": {"type": "number", "minimum": 1, "maximum": 100},
        "metadataWarningPercent": {"type": "number", "minimum": 1, "maximum": 99},
        "metadataCriticalPercent": {"type": "number", "minimum": 1, "maximum": 100}
      }
    },
    "hostSaturation": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeExporterJob", "window", "pressurePercent"],
      "properties": {
        "nodeExporterJob": {"$ref": "#/definitions/job"},
        "window": {"$ref": "#/definitions/duration"},
        "pressurePercent": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory", "io"],
          "properties": {
            "cpu": {"type": "number", "minimum": 0.1, "maximum": 100},
            "memory": {"type": "number", "minimum": 0.1, "maximum": 100},
            "io": {"type": "number", "minimum": 0.1, "maximum": 100}
          }
        }
      }
    },
    "thanosCompactor": {"$ref": "#/definitions/jobOnly"},
    "alertingHealth": {
      "type": "object", "additionalProperties": false, "required": ["window", "maxEvaluationSeconds"],
      "properties": {
        "window": {"$ref": "#/definitions/duration"},
        "maxEvaluationSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "alerts": {
      "type": "object", "additionalProperties": false, "required": ["owner", "watchdog", "for"],
      "properties": {
        "owner": {"type": "string", "enum": ["platform", "openstack", "storage", "sre"]},
        "watchdog": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "for"],
          "properties": {"enabled": {"type": "boolean"}, "for": {"$ref": "#/definitions/duration"}}
        },
        "for": {
          "type": "object", "additionalProperties": false,
          "required": ["telemetry", "remoteWrite", "remoteWriteLag", "openstackFamily", "libvirtInventory", "cinderCollector", "cinderCapacity", "hostSaturation", "compactor", "alertingComponent", "evaluationFailure", "evaluationSlow", "alertmanagerConfig", "notificationFailure"],
          "properties": {
            "telemetry": {"$ref": "#/definitions/duration"}, "remoteWrite": {"$ref": "#/definitions/duration"},
            "remoteWriteLag": {"$ref": "#/definitions/duration"}, "openstackFamily": {"$ref": "#/definitions/duration"},
            "libvirtInventory": {"$ref": "#/definitions/duration"}, "cinderCollector": {"$ref": "#/definitions/duration"},
            "cinderCapacity": {"$ref": "#/definitions/duration"}, "hostSaturation": {"$ref": "#/definitions/duration"},
            "compactor": {"$ref": "#/definitions/duration"}, "alertingComponent": {"$ref": "#/definitions/duration"},
            "evaluationFailure": {"$ref": "#/definitions/duration"}, "evaluationSlow": {"$ref": "#/definitions/duration"},
            "alertmanagerConfig": {"$ref": "#/definitions/duration"}, "notificationFailure": {"$ref": "#/definitions/duration"}
          }
        }
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false, "required": ["image", "promtoolImage"],
      "properties": {"image": {"$ref": "#/definitions/image"}, "promtoolImage": {"$ref": "#/definitions/image"}}
    }
  },
  "required": ["identity", "links", "thanosRuler", "alertmanager", "delivery", "routing", "monitoring", "telemetry", "openstack", "libvirt", "cinder", "hostSaturation", "thanosCompactor", "alertingHealth", "alerts", "tests"],
  "definitions": {
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$"},
    "job": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_./-]{0,126}$"},
    "quantity": {"type": "string", "pattern": "^[0-9]+(m|Mi|Gi)?$"},
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository", "tag"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}}
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}}},
        "limits": {"type": "object", "additionalProperties": false, "required": ["memory"], "properties": {"memory": {"$ref": "#/definitions/quantity"}}}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["size", "storageClassName"],
      "properties": {"size": {"type": "string", "pattern": "^[1-9][0-9]*Gi$"}, "storageClassName": {"type": "string", "maxLength": 253}}
    },
    "thanosRuler": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "replicas", "queryEndpoint", "alertmanagerEndpoint", "evaluationInterval", "retention", "logLevel", "resources", "storage"],
      "properties": {
        "version": {"type": "string", "pattern": "^v0\\.42\\.[0-9]+$"}, "replicas": {"type": "integer", "minimum": 1, "maximum": 3},
        "queryEndpoint": {"type": "string", "pattern": "^https?://.+"}, "alertmanagerEndpoint": {"type": "string", "pattern": "^(|https?://.+)$"},
        "evaluationInterval": {"$ref": "#/definitions/duration"}, "retention": {"$ref": "#/definitions/duration"},
        "logLevel": {"enum": ["debug", "info", "warn", "error"]}, "resources": {"$ref": "#/definitions/resources"}, "storage": {"$ref": "#/definitions/storage"}
      }
    },
    "alertmanager": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "replicas", "externalUrl", "retention", "logLevel", "resources", "storage"],
      "properties": {
        "version": {"type": "string", "pattern": "^v0\\.[0-9]+\\.[0-9]+$"}, "replicas": {"type": "integer", "minimum": 1, "maximum": 3},
        "externalUrl": {"type": "string", "pattern": "^https?://.+"}, "retention": {"$ref": "#/definitions/duration"},
        "logLevel": {"enum": ["debug", "info", "warn", "error"]}, "resources": {"$ref": "#/definitions/resources"}, "storage": {"$ref": "#/definitions/storage"}
      }
    },
    "monitoring": {
      "type": "object", "additionalProperties": false, "required": ["interval", "scrapeTimeout", "sampleLimit", "targetLimit", "rulerJob", "alertmanagerJob"],
      "properties": {
        "interval": {"$ref": "#/definitions/duration"},
        "scrapeTimeout": {"$ref": "#/definitions/duration"},
        "sampleLimit": {"type": "integer", "minimum": 100, "maximum": 3000},
        "targetLimit": {"type": "integer", "minimum": 1, "maximum": 3},
        "rulerJob": {"$ref": "#/definitions/job"},
        "alertmanagerJob": {"$ref": "#/definitions/job"}
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false, "required": ["staleAfterSeconds", "expectedHubTargets", "expectedAi1Targets", "remoteWrite"],
      "properties": {
        "staleAfterSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "expectedHubTargets": {"$ref": "#/definitions/expectedTargets"},
        "expectedAi1Targets": {"$ref": "#/definitions/expectedTargets"},
        "remoteWrite": {
          "type": "object", "additionalProperties": false, "required": ["job", "window", "maxLagSeconds"],
          "properties": {"job": {"$ref": "#/definitions/job"}, "window": {"$ref": "#/definitions/duration"}, "maxLagSeconds": {"type": "integer", "minimum": 30, "maximum": 3600}}
        }
      }
    },
    "expectedTargets": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "job", "instance", "component"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}, "job": {"$ref": "#/definitions/job"},
              "instance": {"type": "string", "minLength": 1, "maxLength": 253},
              "component": {"enum": ["alloy", "node-exporter", "openstack-exporter", "libvirt-exporter", "cinder-metrics", "thanos"]}
            }
          }
    },
    "jobOnly": {"type": "object", "additionalProperties": false, "required": ["job"], "properties": {"job": {"$ref": "#/definitions/job"}}}
  }
}
