{
  "annotations": {
    "list": []
  },
  "description": "Operational health of the obs-w alert-evaluation, notification, and metrics-delivery path. Missing data is intentionally not converted to a healthy zero.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Grafana alert state",
      "type": "link",
      "url": "/alerting/list"
    },
    {
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "OpenStack telemetry integrity",
      "type": "link",
      "url": "/d/ai1-telemetry-integrity"
    }
  ],
  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "**Read left to right:** evaluator → alert state → notification → telemetry path → Thanos backend. A blank panel is **unknown**, not healthy. Confirm target discovery and sample freshness before interpreting an empty result.\n\n**Identity:** `ALERTS` rule-result series arrive through the Ruler StoreAPI and are scoped by `cluster`; scraped component metrics arrive through Receive and are scoped by `tenant_id` plus `cluster`.\n\n**Thresholds:** evaluation should finish inside its 60-second interval; notification failures and dropped samples should remain absent; remote-write lag above 120 seconds needs investigation; Query p95 above 5 seconds breaches the initial budget. Use the alert list link for acknowledgement and silencing.",
        "mode": "markdown"
      },
      "title": "Operator note",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "panels": [],
      "title": "Alert lifecycle",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current pending and firing rule-result series from the Ruler StoreAPI, scoped by cluster because Ruler external labels must not claim Receive-owned tenant_id. No result does not prove Ruler evaluation is healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "links": [
        {
          "targetBlank": false,
          "title": "Open alert state",
          "url": "/alerting/list"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "count by (alertstate) (ALERTS{cluster=\"$cluster\",alertstate=~\"pending|firing\"})",
          "instant": true,
          "legendFormat": "{{alertstate}}",
          "refId": "A"
        }
      ],
      "title": "Pending and firing alerts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Firing rule-result series from the Ruler StoreAPI, scoped by cluster and grouped by the bounded portfolio labels. Alert details, acknowledgement, and silences remain in the alerting UI.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 5
      },
      "id": 4,
      "links": [
        {
          "targetBlank": false,
          "title": "Acknowledge or silence",
          "url": "/alerting/list"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "max by (alertname, severity, owner, service, component, scope, alert_family) (ALERTS{cluster=\"$cluster\",alertstate=\"firing\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }
      ],
      "title": "Firing alert portfolio",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 5,
      "panels": [],
      "title": "Thanos Ruler",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Last evaluation duration by rule group. The initial contract expects p99 below 30 seconds and every group to remain below its 60-second interval.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (rule_group) (prometheus_rule_group_last_duration_seconds{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/thanos-ruler\"})",
          "legendFormat": "{{rule_group}}",
          "refId": "A"
        }
      ],
      "title": "Rule-group evaluation duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Failed rule evaluations per second. Any sustained non-zero result warrants inspecting Ruler logs and the affected rule group; missing data is not success.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 12
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(prometheus_rule_evaluation_failures_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/thanos-ruler\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "failed evaluations",
          "refId": "A"
        }
      ],
      "title": "Evaluation failures",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Warnings emitted during rule evaluation. Warnings can indicate partial responses or incomplete evaluation even when the evaluation itself did not fail.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "bars",
            "fillOpacity": 30,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(thanos_rule_evaluation_with_warnings_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/thanos-ruler\"}[$__rate_interval]))",
          "legendFormat": "warnings/s",
          "refId": "A"
        }
      ],
      "title": "Evaluation warnings",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Seconds since each rule group last completed an evaluation. Values above 120 seconds indicate stalled evaluation for a 60-second group; missing groups are unknown.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "time() - max by (rule_group) (prometheus_rule_group_last_evaluation_timestamp_seconds{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/thanos-ruler\"})",
          "legendFormat": "{{rule_group}}",
          "refId": "A"
        }
      ],
      "title": "Time since rule-group evaluation",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 10,
      "panels": [],
      "title": "Alertmanager delivery",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Notification attempts split into successful and failed rates by bounded receiver integration. Success is total minus failed; missing counters remain no data.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/failed/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (integration) (rate(alertmanager_notifications_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alertmanager\"}[$__rate_interval])) - sum by (integration) (rate(alertmanager_notifications_failed_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alertmanager\"}[$__rate_interval]))",
          "legendFormat": "{{integration}} successful/s",
          "refId": "A"
        },
        {
          "expr": "sum by (integration) (rate(alertmanager_notifications_failed_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alertmanager\"}[$__rate_interval]))",
          "legendFormat": "{{integration}} failed/s",
          "refId": "B"
        }
      ],
      "title": "Notification outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Failed notifications divided by all notification attempts. Any non-zero value is delivery degradation; a missing result is not success.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 26
      },
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(alertmanager_notifications_failed_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alertmanager\"}[$__rate_interval])) / sum(rate(alertmanager_notifications_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alertmanager\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "notification failures",
          "refId": "A"
        }
      ],
      "title": "Notification failure ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "95th-percentile notification latency by integration. Interpret alongside failure rate because a failed delivery may not contribute a successful latency observation.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (integration, le) (rate(alertmanager_notification_latency_seconds_bucket{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alertmanager\"}[$__rate_interval])))",
          "legendFormat": "{{integration}} p95",
          "refId": "A"
        }
      ],
      "title": "Notification latency p95",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 14,
      "panels": [],
      "title": "Hub Alloy remote write",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Failed and dropped samples from the hub collector should remain absent. Metrics can only arrive after the sender reconnects, so use target freshness to detect a complete path outage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/failed|dropped/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "id": 15,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(prometheus_remote_storage_samples_failed_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alloy\"}[$__rate_interval]))",
          "legendFormat": "failed/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(prometheus_remote_storage_samples_dropped_total{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alloy\"}[$__rate_interval]))",
          "legendFormat": "dropped/s",
          "refId": "B"
        }
      ],
      "title": "Remote-write sample failures",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Seconds behind wall clock for the highest timestamp sent. Above 120 seconds breaches the initial normal-operation budget; this signal is retrospective during a complete sender outage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 34
      },
      "id": 16,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "time() - max(prometheus_remote_storage_queue_highest_sent_timestamp_seconds{tenant_id=\"$tenant_id\",cluster=\"$cluster\",job=\"integrations/alloy\"})",
          "instant": true,
          "legendFormat": "lag",
          "refId": "A"
        }
      ],
      "title": "Highest-sent timestamp lag",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Queued samples measure delivery backlog. A rising series indicates that remote write cannot keep pace; missing data requires checking the Alloy target itself.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 34
      },
      "id": 17,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
