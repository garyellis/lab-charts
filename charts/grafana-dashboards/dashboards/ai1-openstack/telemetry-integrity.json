        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "lab",
          "value": "lab"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Tenant",
        "multi": false,
        "name": "tenant_id",
        "options": [
          {
            "selected": true,
            "text": "lab",
            "value": "lab"
          }
        ],
        "query": "lab",
        "type": "custom"
      },
      {
        "current": {
          "selected": true,
          "text": "ai1",
          "value": "ai1"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Infrastructure",
        "multi": false,
        "name": "infra",
        "options": [
          {
            "selected": true,
            "text": "ai1",
            "value": "ai1"
          }
        ],
        "query": "ai1",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "timezone": "browser",
  "title": "AI1 — Telemetry Integrity and Cost",
