        {"expr": "sum by (package) (rate(node_cpu_core_throttles_total{tenant_id=\"$tenant_id\",infra=\"$infra\",infra_role=\"cloud-host\",cloud=\"openstack\"}[$__rate_interval]))", "legendFormat": "package {{package}} cores", "refId": "B"}
