      "targets": [{"expr": "node_hwmon_temp_alarm{tenant_id=\"$tenant_id\",infra=\"$infra\",infra_role=\"cloud-host\",cloud=\"openstack\"}", "instant": true, "legendFormat": "{{chip}} · {{sensor}} alarm", "refId": "A"}],
      "title": "Temperature alarm flags",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
