        {"expr": "node_hwmon_temp_max_celsius{tenant_id=\"$tenant_id\",infra=\"$infra\",infra_role=\"cloud-host\",cloud=\"openstack\"} * on (instance, chip, sensor) group_left(label) node_hwmon_sensor_label{tenant_id=\"$tenant_id\",infra=\"$infra\",infra_role=\"cloud-host\",cloud=\"openstack\"}", "legendFormat": "{{chip}} · {{label}} max", "refId": "B"},
        {"expr": "node_hwmon_temp_crit_celsius{tenant_id=\"$tenant_id\",infra=\"$infra\",infra_role=\"cloud-host\",cloud=\"openstack\"} * on (instance, chip, sensor) group_left(label) node_hwmon_sensor_label{tenant_id=\"$tenant_id\",infra=\"$infra\",infra_role=\"cloud-host\",cloud=\"openstack\"}", "legendFormat": "{{chip}} · {{label}} critical", "refId": "C"}
      ],
      "title": "Temperature thresholds",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
