        {"expr": "node_cooling_device_max_state{tenant_id=\"$tenant_id\",infra=\"$infra\",infra_role=\"cloud-host\",cloud=\"openstack\"}", "legendFormat": "{{type}} {{name}} max", "refId": "B"}
